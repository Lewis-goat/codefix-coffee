---
import Base from '../../layouts/Base.astro';
import { models, codesByModel } from '../../data/breville';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Breville / Sage', href: '/breville' }];
---
<Base title="Breville and Sage espresso machine error codes (all models)" description="Complete Breville / Sage error code lists for the Barista Touch, Barista Touch Impress, Oracle, Oracle Touch, Oracle Jet and Dual Boiler, each with a fix-first page per code." crumbs={crumbs}>
  <h1>Breville / Sage error codes by machine</h1>
  <p class="lead">Breville does not publish these tables. They come from service documentation and repair-shop references, cross-checked against owner reports.</p>
  <div class="grid">
    {models.map((m) => (
      <a href={`/breville/${m.slug}`}><strong>{m.name} ({m.sku})</strong><small>{codesByModel[m.sku].length} codes · shown as "{m.codePrefix}{codesByModel[m.sku][0].code.replace(/^(ER|E|Error )/, '')}"</small></a>
    ))}
  </div>
  <h2>Which code format does your machine use?</h2>
  <div class="tablewrap"><table>
    <tr><th>On screen</th><th>Machine</th></tr>
    <tr><td><code>ER05</code> style, two digits</td><td>Barista Touch, Barista Touch Impress, Oracle Touch</td></tr>
    <tr><td><code>Error 15</code> in the service log</td><td>Oracle BES980</td></tr>
    <tr><td><code>E7</code> style, one or two digits</td><td>Oracle Jet</td></tr>
    <tr><td><code>08</code> in the hidden self-check menu</td><td>Dual Boiler BES920</td></tr>
  </table></div>
</Base>
