---
import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { models, codesByModel, codeSlug, playbooks, deepDives } from '../../../data/breville';
export function getStaticPaths() {
  return models.flatMap((m) => codesByModel[m.sku].map((c) => ({ params: { model: m.slug, code: codeSlug(c.code) }, props: { m, c } })));
}
const { m, c } = Astro.props;
const pb = playbooks[c.category];
const dd = deepDives[`${m.sku}:${c.code}`];
const shown = `${m.codePrefix}${c.code.replace(/^(ER|E|Error )/, '')}`;
const quick = pb.quickAnswer(c, m);
const steps = pb.steps(c, m);
const siblings = codesByModel[m.sku].filter((x) => x.component === c.component && x.code !== c.code);
const sameCategoryOther = models.filter((x) => x.sku !== m.sku).flatMap((x) => codesByModel[x.sku].filter((y) => y.meaning === c.meaning).map((y) => ({ x, y }))).slice(0, 4);
const title = `Breville ${m.name} ${shown}: what it means and how to fix it`;
const desc = `${shown} on the Breville / Sage ${m.name} (${m.sku}) means: ${c.meaning}. The fix, the part (${c.component}), the cost, and whether it is worth repairing.`;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Breville / Sage', href: '/breville' }, { name: m.name, href: `/breville/${m.slug}` }, { name: shown, href: `/breville/${m.slug}/${codeSlug(c.code)}` }];
const faq = [
  { q: `What does ${shown} mean on the Breville ${m.name}?`, a: `${c.meaning}. ${quick}` },
  { q: `Can I fix ${shown} myself?`, a: `DIY difficulty: ${pb.diy}. ${steps[0]} ${steps[1]}` },
  { q: `How much does it cost to fix ${shown}?`, a: `${pb.partCost} ${pb.serviceCost}` },
  { q: `Is the ${m.name} worth repairing after ${shown}?`, a: pb.worth },
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'HowTo', name: `Fix ${shown} on the Breville ${m.name}`, description: quick, step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, text: s })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={title} description={desc} jsonLd={ld} crumbs={crumbs}>
  <h1>Breville {m.name} {shown}: {pb.title.toLowerCase()}</h1>
  <p class="lead"><strong>{shown} means:</strong> {c.meaning}.</p>

  <div class="box answer">
    <strong>Short answer.</strong> {quick}
    {dd && <p style="margin-bottom:0">{dd.intro}</p>}
  </div>

  <div class="facts">
    <div><b>Part at fault</b>{c.component}</div>
    <div><b>Severity</b><span class={`sev-${pb.severity}`}>{pb.severity}</span></div>
    <div><b>DIY difficulty</b>{pb.diy}</div>
    <div><b>When it appears</b>{c.phase === 'startup' ? 'during the power-on self-test' : c.phase === 'operation' ? 'while brewing or steaming' : 'any time'}</div>
  </div>

  <h2>How to fix {shown}</h2>
  <ol class="steps">{steps.map((s) => <li>{s}</li>)}</ol>
  {dd && dd.extra.map((p) => <p>{p}</p>)}

  <AdSlot />

  <h2>When to stop and call a repairer</h2>
  <p>{pb.stop}</p>

  <h2>What it costs</h2>
  <p><strong>Parts:</strong> {pb.partCost}</p>
  <p><strong>Service:</strong> {pb.serviceCost}</p>
  <p><strong>Worth repairing?</strong> {pb.worth}</p>

  <h2>How to check the error log on the {m.name}</h2>
  <p>{m.logAccess}</p>
  <p class="note">Clear the log after a repair so you can tell whether the fault has really gone.</p>

  {siblings.length > 0 && (
    <>
      <h2>Related codes on the same part</h2>
      <ul>{siblings.map((s) => <li><a href={`/breville/${m.slug}/${codeSlug(s.code)}`}>{m.codePrefix}{s.code.replace(/^(ER|E|Error )/, '')}</a> — {s.meaning}</li>)}</ul>
    </>
  )}
  {sameCategoryOther.length > 0 && (
    <>
      <h2>Same fault on other Breville machines</h2>
      <ul>{sameCategoryOther.map(({ x, y }) => <li><a href={`/breville/${x.slug}/${codeSlug(y.code)}`}>{x.name} {x.codePrefix}{y.code.replace(/^(ER|E|Error )/, '')}</a></li>)}</ul>
    </>
  )}

  <h2>FAQ</h2>
  {faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}

  <p class="note">Code meanings are taken from Breville service references for the {m.sku}; fixes are based on documented repairs and owner reports. Model revisions can differ. If your machine is under warranty, contact Breville before opening it.</p>
</Base>
