---
import { SITE } from '../site';
interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  crumbs?: { name: string; href: string }[];
}
const { title, description, jsonLd = [], crumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const breadcrumbLd = crumbs.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, Astro.site).toString() })),
} : null;
const allLd = [...jsonLd, ...(breadcrumbLd ? [breadcrumbLd] : [])];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>☕</text></svg>" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  {SITE.adsenseClient && (
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
  )}
  <style is:global>
    :root { --ink:#1f1a17; --muted:#6b625c; --bg:#fbf8f4; --card:#fff; --line:#e6ddd4; --accent:#8b4a2b; --ok:#2e7d4f; --warn:#b26a00; --bad:#b3261e; }
    * { box-sizing: border-box; }
    body { margin:0; font: 17px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color:var(--ink); background:var(--bg); }
    a { color: var(--accent); }
    header.site { border-bottom:1px solid var(--line); background:var(--card); }
    header.site .in { max-width: 960px; margin:0 auto; padding: 12px 20px; display:flex; align-items:center; justify-content:space-between; gap: 16px; flex-wrap: wrap; }
    header.site a.brand { font-weight: 700; text-decoration:none; color:var(--ink); font-size: 20px; }
    header.site nav a { margin-left: 16px; text-decoration:none; color:var(--muted); }
    main { max-width: 960px; margin: 0 auto; padding: 24px 20px 48px; }
    nav.crumbs { font-size: 14px; color: var(--muted); margin-bottom: 12px; }
    nav.crumbs a { color: var(--muted); }
    h1 { font-size: 30px; line-height: 1.2; margin: 0 0 12px; }
    h2 { font-size: 22px; margin: 32px 0 10px; }
    h3 { font-size: 18px; margin: 20px 0 6px; }
    .lead { font-size: 19px; color: var(--muted); margin: 0 0 20px; }
    .box { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px; margin: 16px 0; }
    .box.answer { border-left: 5px solid var(--accent); }
    .facts { display:grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: 12px; margin: 16px 0; }
    .facts div { background: var(--card); border:1px solid var(--line); border-radius: 8px; padding: 10px 12px; font-size: 15px; }
    .facts b { display:block; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
    .sev-low { color: var(--ok); } .sev-medium { color: var(--warn); } .sev-high { color: var(--bad); }
    ol.steps li { margin-bottom: 10px; }
    table { border-collapse: collapse; width: 100%; font-size: 15px; }
    th, td { text-align:left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { background: #f3ece5; }
    .tablewrap { overflow-x: auto; }
    code { background:#f3ece5; padding: 1px 6px; border-radius: 4px; font-size: 15px; }
    .ad { min-height: 90px; margin: 24px 0; }
    .grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: 12px; }
    .grid a { display:block; background: var(--card); border:1px solid var(--line); border-radius: 8px; padding: 12px 14px; text-decoration: none; color: var(--ink); }
    .grid a small { display:block; color: var(--muted); }
    .note { font-size: 14px; color: var(--muted); }
    footer { border-top: 1px solid var(--line); margin-top: 32px; padding: 20px; text-align:center; font-size: 14px; color: var(--muted); }
    footer a { color: var(--muted); margin: 0 8px; }
  </style>
</head>
<body>
  <header class="site"><div class="in">
    <a class="brand" href="/">☕ {SITE.name}</a>
    <nav><a href="/breville">Breville</a><a href="/jura">Jura</a><a href="/philips-saeco">Philips / Saeco</a><a href="/delonghi">De&#39;Longhi</a><a href="/ge">GE</a><a href="/samsung">Samsung</a></nav>
  </div></header>
  <main>
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumbs.map((c, i) => <>{i > 0 && ' › '}<a href={c.href}>{c.name}</a></>)}
      </nav>
    )}
    <slot />
  </main>
  <footer>
    <div>{SITE.name} — independent repair reference. Not affiliated with Breville, Sage or any manufacturer. Service-mode instructions are for information; opening a machine may void its warranty. Last reviewed {SITE.updated}.</div>
    <div><a href="/about">About</a><a href="/privacy">Privacy</a><a href="/contact">Contact</a></div>
  </footer>
</body>
</html>
